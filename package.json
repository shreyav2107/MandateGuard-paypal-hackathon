{
  "name": "mandateguard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:check": "tsx --env-file=.env.local scripts/db-check.ts",
    "db:migrate": "tsx --env-file=.env.local scripts/db-migrate.ts",
    "fixtures": "tsx --env-file=.env.local scripts/save-fixtures.ts",
    "ai:check": "tsx --env-file=.env.local scripts/ai-check.ts",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke-test.ts",
    "ai:eval": "tsx --env-file-if-exists=.env.local scripts/intent-eval.ts",
    "ai:demo": "tsx --env-file-if-exists=.env.local scripts/ai-demo.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
